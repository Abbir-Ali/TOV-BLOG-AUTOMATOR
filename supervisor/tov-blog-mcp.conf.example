; =============================================================================
; Supervisor config for tov-blog-mcp
; Copy to: /etc/supervisor/conf.d/tov-blog-mcp.conf
; Fill in all REPLACE_ME values, then:
;   sudo supervisorctl reread && sudo supervisorctl update
; =============================================================================

[program:tov-blog-mcp]

command=/usr/bin/node /opt/tov-blog-mcp/dist/index.js
directory=/opt/tov-blog-mcp
user=REPLACE_ME                         ; e.g. ubuntu, deploy, www-data

environment=
    NODE_ENV="production",
    HTTP_PORT="3100",
    MCP_ENV="prod",
    DRY_RUN="false",
    SHOPIFY_STORE_DOMAIN="REPLACE_ME",
    ALLOWED_STORES="REPLACE_ME",
    SHOPIFY_API_VERSION="2026-10",
    SHOPIFY_ADMIN_TOKEN="REPLACE_ME",
    PUBLIC_STORE_URL="https://tovfurniture.com",
    GOOGLE_SERVICE_ACCOUNT_JSON="REPLACE_ME_BASE64",
    ALLOWED_API_KEYS="REPLACE_ME_KEY1,REPLACE_ME_KEY2"

autostart=true
autorestart=true
startretries=5
startsecs=3

stdout_logfile=/var/log/supervisor/tov-blog-mcp.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
stderr_logfile=/var/log/supervisor/tov-blog-mcp-error.log
stderr_logfile_maxbytes=10MB
stderr_logfile_backups=5

stopsignal=TERM
stopwaitsecs=10
