{
  "name": "tov-blog-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "tov-shopify MCP server: turns TOV Google Doc blog briefs into Shopify article drafts (drafts only).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tov-shopify": "dist/index.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:golden": "vitest run tests/golden",
    "test:cleanup": "node dist/scripts/cleanup.js",
    "setup:dev": "node dist/scripts/setup-dev.js",
    "admin": "node dist/scripts/admin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "googleapis": "^185.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
