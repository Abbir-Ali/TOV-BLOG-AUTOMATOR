# tov-shopify MCP server — copy to .env and fill in. Never commit .env.

# ---- Shopify ----
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
# Comma-separated. The server refuses to run against any store not listed here.
ALLOWED_STORES=your-dev-store.myshopify.com
SHOPIFY_API_VERSION=2026-10
# Client-credentials token (Dev Dashboard app)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only if using a static token (legacy custom app). Takes precedence over client credentials.
SHOPIFY_ADMIN_TOKEN=
# Public storefront base used to build product links (PDP URLs)
PUBLIC_STORE_URL=https://your-store.com/

# ---- Google ----
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# OR: base64-encoded JSON key for containerised/server deployments (no file needed)
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Runtime ----
# test | prod — in test, drafts get the mcp-test tag and delete_test_article is registered
MCP_ENV=test
# true → create/update return the exact GraphQL variables instead of calling Shopify
DRY_RUN=true

# ---- HTTP transport ----
# Leave blank to run in stdio mode only (Kiro / MCP Inspector).
# Set to a port number (e.g. 3101) to start the HTTP server.
HTTP_PORT=

# ---- OAuth 2.0 (recommended for production / Claude.ai connector) ----
# Public base URL of this server as Claude sees it.
# For production: https://app.tovfurniture.com/mcp/tov-blog
# For local ngrok testing: https://xxxx.ngrok-free.app
OAUTH_BASE_URL=

# 64-char hex secret for signing JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_SECRET=

# Path to the SQLite database file (created automatically).
# Default: <project-root>/data/oauth.db
OAUTH_DB_PATH=

# Comma-separated list of email addresses allowed to log in.
# Anyone not on this list is rejected even if they have a valid password.
ALLOWED_EMAILS=danish@renegadefurniture.com,zaid@tovfurniture.com,abbir@tovfurniture.com,camille@tovfurniture.com,daniela@tovfurniture.com,shmaya@renegadefurniture.com

# Token lifetimes in seconds (defaults: 3600 = 1hr access, 86400 = 24hr refresh)
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=86400

# ---- Legacy API keys (Kiro / local testing only) ----
# When OAUTH_BASE_URL is set, OAuth takes precedence.
# Keep this set for Kiro local access alongside OAuth.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALLOWED_API_KEYS=
