# tov-shopify MCP server — production .env for /srv/tov-blog-mcp/.env
# Fill in every REPLACE_ME value. Never commit this file with real secrets.
# Permissions: chmod 600 /srv/tov-blog-mcp/.env

# ---- Shopify (live store) ----
# Must be bare hostname only — no https://, no trailing slash.
SHOPIFY_STORE_DOMAIN=tovfurniture.myshopify.com
ALLOWED_STORES=tovfurniture.myshopify.com
SHOPIFY_API_VERSION=2025-01
# Static Admin API token from the Shopify Partner Dashboard app installed on tovfurniture.myshopify.com
# Required scopes: read_content, write_content, read_products, read_files, write_files
SHOPIFY_ADMIN_TOKEN=REPLACE_ME
# Not used when SHOPIFY_ADMIN_TOKEN is set — leave blank
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Public storefront URL used to build product PDP links
PUBLIC_STORE_URL=https://tovfurniture.com

# ---- Google Docs (service account) ----
# Use base64-encoded JSON (no file needed on server). Generate with:
#   base64 -w 0 /path/to/service-account.json
# Paste the entire output as a single line — no line breaks.
GOOGLE_SERVICE_ACCOUNT_JSON=REPLACE_ME_BASE64

# ---- Runtime ----
# prod = no mcp-test tag, delete_test_article tool not registered
MCP_ENV=prod
# Set true for first runs to verify output before writing to live store.
# Change to false once dry-run output looks correct.
DRY_RUN=true

# ---- HTTP transport ----
# Port the Node server listens on. Nginx proxies /mcp/tov-blog → this port.
HTTP_PORT=3101

# ---- OAuth 2.0 ----
# Public base URL — must match the URL Claude uses to connect.
OAUTH_BASE_URL=https://app.tovfurniture.com/mcp/tov-blog
# 64-char hex secret for signing JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_SECRET=REPLACE_ME_64CHAR_HEX
# SQLite database path (created automatically on first start)
OAUTH_DB_PATH=/srv/tov-blog-mcp/data/oauth.db
# Access token lifetime (seconds) — 1 hour
OAUTH_ACCESS_TOKEN_TTL=3600
# Refresh token lifetime (seconds) — 24 hours
OAUTH_REFRESH_TOKEN_TTL=86400

# ---- Authorised users ----
# Only these email addresses can log in via the OAuth login form.
# Add with: node dist/scripts/admin.js add <email>
ALLOWED_EMAILS=danish@renegadefurniture.com,zaid@tovfurniture.com,abbir@tovfurniture.com,camille@tovfurniture.com,daniela@tovfurniture.com,shmaya@renegadefurniture.com

# ---- Legacy API keys (Kiro / local only — not used in production) ----
ALLOWED_API_KEYS=
