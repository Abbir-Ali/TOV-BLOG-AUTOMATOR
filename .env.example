# tov-shopify MCP server — copy to .env and fill in. Never commit .env.
SHOPIFY_STORE_DOMAIN=tov-dev-store.myshopify.com
# Comma-separated. The server refuses to run against any store not listed here.
ALLOWED_STORES=tov-dev-store.myshopify.com
SHOPIFY_API_VERSION=2026-10
# Client-credentials token (Dev Dashboard app) — refreshed automatically when expired
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only if using a static token (legacy custom app). Takes precedence over client credentials.
SHOPIFY_ADMIN_TOKEN=
# Public storefront base used to build product links (PDP URLs)
PUBLIC_STORE_URL=https://tovfurniture.com
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# test | prod — in test, drafts get the mcp-test tag and delete_test_article is registered
MCP_ENV=test
# true → create/update return the exact GraphQL variables instead of calling Shopify
DRY_RUN=false
