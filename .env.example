# tov-shopify MCP server — copy to .env and fill in. Never commit .env.

# ---- Shopify ----
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
# Comma-separated. The server refuses to run against any store not listed here.
ALLOWED_STORES=your-dev-store.myshopify.com
SHOPIFY_API_VERSION=2026-10
# Client-credentials token (Dev Dashboard app)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only if using a static token (legacy custom app). Takes precedence over client credentials.
SHOPIFY_ADMIN_TOKEN=
# Public storefront base used to build product links (PDP URLs)
PUBLIC_STORE_URL=https://your-store.com/

# ---- Google ----
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# ---- Runtime ----
# test | prod — in test, drafts get the mcp-test tag and delete_test_article is registered
MCP_ENV=test
# true → create/update return the exact GraphQL variables instead of calling Shopify
DRY_RUN=true

# ---- HTTP transport (Claude.ai custom connector) ----
# Leave blank to run in stdio mode only (Kiro / MCP Inspector).
# Set to a port number (e.g. 3100) to also start the Streamable HTTP server.
HTTP_PORT=

# Comma-separated bearer tokens for the HTTP transport.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Anyone with a token can call all tools — treat these like passwords.
# Leave blank to disable HTTP transport entirely (server will refuse connections if HTTP_PORT is set).
ALLOWED_API_KEYS=
